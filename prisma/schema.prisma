// Prisma schema for the RPG Telegram bot.
// See README.md "Design decisions" for the reasoning behind models that go
// beyond the minimum spec (GroupMember, SceneTemplate, SceneMessage, BotSession).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TopicType {
  SETUP
  CASTING
  INTRO
  SCENE
  FEED
}

enum TopicStatus {
  ACTIVE
  CLOSED
}

enum CharacterStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SceneStatus {
  CASTING
  OPEN
  CLOSED
}

/// A Telegram group (supergroup) the bot has been set up in.
model Group {
  id                  String   @id @default(cuid())
  telegramChatId      BigInt   @unique
  title               String
  isForumEnabled      Boolean  @default(false)
  /// Message id (in the Casting topic) of the pinned scene index — a single
  /// message listing every scene with buttons that deep-link straight to its
  /// topic, so admins/players don't have to hunt through the sidebar. See
  /// README "Design decisions".
  sceneIndexMessageId Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  topics            Topic[]
  characters        Character[]
  scenes            Scene[]
  ephemeralMessages EphemeralMessage[]
  members           GroupMember[]
  templates         SceneTemplate[]
  posts             Post[]
  feedPersonas      FeedPersona[]
}

/// A forum topic (thread) the bot manages within a group.
model Topic {
  id              String      @id @default(cuid())
  telegramTopicId Int
  groupId         String
  type            TopicType
  status          TopicStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scene Scene?

  @@unique([groupId, telegramTopicId])
  @@index([groupId])
}

/// A roleplay character proposed by a group member, subject to admin approval.
model Character {
  id                String          @id @default(cuid())
  groupId           String
  name              String
  description       String
  avatarFileId      String?
  status            CharacterStatus @default(PENDING)
  proposedByUserId  BigInt
  proposalMessageId Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sceneCasts   SceneCast[]
  activeRoles  ActiveRole[]
  posts        Post[]
  postComments PostComment[]
  feedPersonas FeedPersona[]

  @@index([groupId])
  @@index([groupId, status])
}

/// A roleplay scene, 1:1 with the forum topic it lives in.
model Scene {
  id               String      @id @default(cuid())
  topicId          String      @unique
  groupId          String
  title            String
  description      String?
  bannerFileId     String?
  status           SceneStatus @default(CASTING)
  createdByUserId  BigInt
  controlMessageId Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  topic    Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  group    Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  casts    SceneCast[]
  active   ActiveRole[]
  messages SceneMessage[]

  @@index([groupId])
  @@index([groupId, status])
}

/// "In THIS scene, this character is played by this user." Scene-scoped only —
/// there is deliberately no global/permanent claim table (see README).
model SceneCast {
  id          String   @id @default(cuid())
  sceneId     String
  characterId String
  userId      BigInt
  createdAt   DateTime @default(now())

  scene     Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
  @@index([sceneId])
  @@index([characterId])
  @@index([sceneId, userId])
}

/// Which character a user is CURRENTLY speaking as, within a specific scene.
/// Read by the delete-and-repost logic before reformatting a message.
model ActiveRole {
  id          String   @id @default(cuid())
  userId      BigInt
  sceneId     String
  characterId String
  updatedAt   DateTime @updatedAt

  scene     Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, sceneId])
  @@index([sceneId])
  @@index([characterId])
}

/// Roster of users the bot has observed sending a message in a group. The Bot
/// API has no "list all members" endpoint, so this roster (built from activity)
/// is what powers the "assign cast" member picker and @username resolution in
/// the cast shorthand parser. See README "Design decisions".
model GroupMember {
  id          String   @id @default(cuid())
  groupId     String
  userId      BigInt
  username    String?
  displayName String
  isAdmin     Boolean  @default(false)
  lastSeenAt  DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([groupId, username])
}

/// A saved scene title+description an admin can reuse via /scene with no args.
model SceneTemplate {
  id              String   @id @default(cuid())
  groupId         String
  name            String
  title           String
  description     String?
  createdByUserId BigInt
  createdAt       DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
  @@index([groupId])
}

/// A log of text seen in an OPEN scene topic (both in-character reposts and
/// OOC passthrough), used by /export to build a transcript. This is the only
/// "history" the bot has, since bots cannot read arbitrary past group history
/// via the Bot API. See README "Design decisions".
model SceneMessage {
  id          String   @id @default(cuid())
  sceneId     String
  userId      BigInt
  displayName String
  text        String
  createdAt   DateTime @default(now())

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
  @@index([sceneId, createdAt])
}

/// Backing store for grammY session data (multi-step flows), so in-progress
/// flows survive a Render restart/redeploy instead of living only in memory.
model BotSession {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Bot-sent prompts/confirmations/errors and the raw replies that fed them —
/// clutter, not RP content or a persistent record. Tracked as they're sent so
/// /cleanup can bulk-delete them on request; never includes pinned control
/// cards, character proposal cards, banners, or actual scene dialogue. See
/// README "Design decisions".
model EphemeralMessage {
  id              String   @id @default(cuid())
  groupId         String
  telegramTopicId Int
  messageId       Int
  createdAt       DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, telegramTopicId])
}

/// Which character a user currently posts/comments as in the 📸 Feed topic.
/// Deliberately a separate, group-scoped concept from ActiveRole (which is
/// per-scene) rather than repurposing it — the Feed isn't a scene, and this
/// keeps the existing scene role-switching untouched. See README "Design
/// decisions".
model FeedPersona {
  id          String   @id @default(cuid())
  groupId     String
  userId      BigInt
  characterId String
  updatedAt   DateTime @updatedAt

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([characterId])
}

/// An in-character "post" to the Feed: a photo the bot reposted (deleting the
/// original) as coming from the character, with a Mini App "view as post"
/// button attached. The photo itself is never stored — only fileId, a
/// pointer Telegram resolves on demand. See README "Design decisions".
model Post {
  id           String   @id @default(cuid())
  groupId      String
  messageId    Int
  characterId  String
  authorUserId BigInt
  fileId       String
  caption      String?
  createdAt    DateTime @default(now())

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  character Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  comments  PostComment[]
  reactions PostReaction[]

  @@unique([groupId, messageId])
  @@index([groupId])
}

/// A reply to a Post's message, captured as it happens (there is no Bot API
/// query for "get replies to message X" — see README "Design decisions").
/// Mirrored into the Mini App's comment thread; the raw chat reply is left
/// untouched in the topic.
model PostComment {
  id          String   @id @default(cuid())
  postId      String
  messageId   Int
  userId      BigInt
  characterId String
  text        String
  createdAt   DateTime @default(now())

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// One row = one user currently has *some* reaction on a Post's message —
/// mirrors Telegram's native reactions as an Instagram-style "like", without
/// caring which emoji. Existence, not emoji identity, is what's tracked;
/// like counts are computed by counting rows, not stored/denormalized.
model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    BigInt
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}
