# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string from your Neon project (use the "pooled" connection string)
# Example: postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# A long, random, hard-to-guess string. Used both as the secret path segment of the
# webhook URL (POST /webhook/:secret) and as the value Telegram echoes back in the
# X-Telegram-Bot-Api-Secret-Token header, so incoming requests can be validated twice.
# Generate one locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# Port the HTTP server listens on. Render injects its own PORT at runtime; this value
# is only used for local development.
PORT=3000

# Public HTTPS base URL the bot is reachable at (no trailing slash), used at boot to
# register the webhook: ${RENDER_EXTERNAL_URL}/webhook/${WEBHOOK_SECRET}
# On Render this is set automatically for you — see render.yaml / README. For local
# webhook testing, set this to your tunnel URL (e.g. an ngrok/cloudflared https URL).
# Leave unset for local `npm run dev:poll` (long polling, no public URL needed).
RENDER_EXTERNAL_URL=
